  // ─── 公開路由 ────────────────────────────────────────────────────────────
  {
    "label": "\ud83e\uddea test:health",
    "type": "shell",
    "command": "Write-Host '=== GET /health ==='; curl.exe -s http://localhost:3000/health",
    "problemMatcher": [],
  },
  {
    "label": "\ud83e\uddea test:openapi",
    "type": "shell",
    "command": "Write-Host '=== GET /openapi ==='; curl.exe -sfo NUL -w 'HTTP %{http_code}' http://localhost:3000/openapi; Write-Host ''; Write-Host '=== GET /openapi/json ==='; curl.exe -sfo NUL -w 'HTTP %{http_code}, content-type: %{content_type}' http://localhost:3000/openapi/json",
    "problemMatcher": [],
  },
  {
    "label": "\ud83e\uddea test:menu-list",
    "type": "shell",
    "command": "Write-Host '=== GET /api/menu (showing first 500 chars) ==='; curl.exe -s http://localhost:3000/api/menu | ForEach-Object { $_.Substring(0, [Math]::Min(500, $_.Length)) }",
    "problemMatcher": [],
  },
  {
    "label": "\ud83e\uddea test:menu-versions",
    "type": "shell",
    "command": "Write-Host '=== GET /api/menu/1/versions ==='; curl.exe -s http://localhost:3000/api/menu/1/versions",
    "problemMatcher": [],
  },

  // ─── \u53d7\u4fdd\u8b77\u8def\u7531\uff08\u7121 cookie \u2192 \u9810\u671f 401\uff09
  // PowerShell: curl.exe -so NUL 將 body 丟棄，-w 只印 HTTP 狀態碼
  {
    "label": "\ud83e\uddea test:auth-me",
    "type": "shell",
    "command": "$s=curl.exe -so NUL -w '%{http_code}' http://localhost:3000/api/auth/me; if($s -eq 401){'OK (401)'}else{'FAIL: expected 401, got '+$s}",
    "problemMatcher": [],
  },
  {
    "label": "\ud83e\uddea test:menu-create",
    "type": "shell",
    "command": "$b='{\"name\":\"test\",\"price\":50,\"category\":\"\u5176\u4ed6\",\"description\":\"test\",\"image_url\":\"/imgs/test.webp\"}'; $s=curl.exe -so NUL -w '%{http_code}' -X POST http://localhost:3000/api/menu -H 'Content-Type: application/json' -d $b; if($s -eq 401){'OK (401)'}else{'FAIL: expected 401, got '+$s}",
    "problemMatcher": [],
  },
  {
    "label": "\ud83e\uddea test:menu-update",
    "type": "shell",
