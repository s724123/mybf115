/**
 * scripts/apply-latest-migration.ts
 *
 * 只跑最新一個 migration（0003_cloudy_preak.sql）。
 * 用於 run-migration.ts 因舊 migration 衝突無法整跑時的替代方案。
 *
 * 用法：bun scripts/apply-latest-migration.ts
 */

import { neonConfig, Pool } from "@neondatabase/serverless";
import ws from "ws";

neonConfig.webSocketConstructor = ws;

const DATABASE_URL =
  process.env.DATABASE_URL_MIGRATION ?? process.env.DATABASE_URL;

if (!DATABASE_URL) {
  console.error("ERROR: DATABASE_URL_MIGRATION or DATABASE_URL is required.");
  process.exit(1);
}

const pool = new Pool({ connectionString: DATABASE_URL });

const statements = [
  `CREATE TABLE "bf_v9"."user_role" (
    "id" text PRIMARY KEY NOT NULL,
    "user_id" text NOT NULL,
    "role" text NOT NULL,
    "created_at" timestamp NOT NULL
  )`,
  `ALTER TABLE "bf_v9"."user_role" ADD CONSTRAINT "user_role_user_id_user_id_fk"
    FOREIGN KEY ("user_id") REFERENCES "bf_v9"."user"("id") ON DELETE cascade ON UPDATE no action`,
  `CREATE UNIQUE INDEX "user_role_user_id_role_idx" ON "bf_v9"."user_role" USING btree ("user_id","role")`,
];

async function main() {
  const client = await pool.connect();
  try {
    for (let i = 0; i < statements.length; i++) {
      const stmt = statements[i]!;
      console.log(`[${i + 1}/${statements.length}] executing...`);
      try {
        await client.query(stmt);
        console.log(`  [✓] done`);
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : String(err);
        if (msg.includes("already exists")) {
          console.warn(`  [skip] ${msg.split("\n")[0]}`);
        } else {
          throw err;
        }
      }
    }
    console.log("\n[✓] user_role migration applied.");
  } finally {
    client.release();
    await pool.end();
  }
}

main().catch((err) => {
  console.error("[FATAL]", err);
  process.exit(1);
});
