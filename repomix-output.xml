<script>
  const fb = {
    q1: {
      ok:  "答對了！訂單一旦成立就是與顧客的法律契約，任何後續的菜單變更（改名、改價、下架）都不應該改寫這份紀錄。這是 Snapshot Pattern 最核心的業務理由。",
      bad: "不對喔。快照設計其實是「反正規化（Denormalization）」，刻意違反了正規化原則，是業務需求優先於技術範式的典型決策。而且快照會占用更多空間，不是為了省空間。"
    },
    q2: {
      ok:  "答對了！itemId 保留是為了讓我們能「跨越時間」——一方面找到現在的菜單狀態做分析（最暢銷商品），另一方面追溯當時的交易記錄。這兩件事都不能少。",
      bad: "不對喔。級聯刪除是外鍵約束的功能，與 itemId 保留的意圖無關。快照設計的精神是訂單「凍結」在當時狀態，不應允許前端在下單後修改快照。"
    },
    q3: {
      ok:  "答對了！第一事實的 orderItemSchema 要求的是 { item: MenuItem, qty } 的巢狀結構。DB row 是攤平的，必須在後端手動 mapping，才能保證前端拿到的資料完全符合第一事實的契約。",
      bad: "不對喔。JSON 序列化與資料庫格式無關，而前端框架也完全能處理巢狀物件。真正的理由是「第一事實的型別定義」要求巢狀結構，後端必須負責轉換以維持契約一致性。"
    }
  };

  function pick(btn) {
    const q   = btn.dataset.q;
    const isOk = btn.dataset.ok === 'true';
    const opts = btn.parentElement;
    const fbEl = document.getElementById(`${q}-fb`);

    [...opts.children].forEach(b => b.classList.remove('ok', 'bad'));
    btn.classList.add(isOk ? 'ok' : 'bad');
    fbEl.className = `quiz-fb ${isOk ? 'ok' : 'bad'}`;
    fbEl.textContent = isOk ? fb[q].ok : fb[q].bad;
  }
</script>
